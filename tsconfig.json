{
    "compilerOptions": {
      "target": "ES2020",
      "module": "ESNext",
      "lib": ["ES2020", "DOM", "DOM.Iterable"],
      "strict": true,
      "jsx": "react-jsx",
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "resolveJsonModule": true,
      "allowJs": true,
      "checkJs": false,
      "allowImportingTsExtensions": true,
      "noEmit": true,
      "moduleResolution": "bundler",
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules"]
  }