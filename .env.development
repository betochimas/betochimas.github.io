# API base URL used by `npm run dev` (Vite dev server).
# Points at a locally running Historical Conflicts API.
VITE_API_BASE_URL=http://localhost:8080

# satorl analysis API (FastAPI on Cloud Run). Public + scale-to-zero, and its CORS
# allows localhost:5173, so dev points straight at prod (no local backend needed).
VITE_SATORL_API_BASE_URL=https://satorl-api-1085902958075.us-west1.run.app
